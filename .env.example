# Ring Partner API
# Playground token (30 min, read-only): https://developer.amazon.com/ring/console/playground
RING_ACCESS_TOKEN=
# HMAC key for webhook v1.1 signatures. Any string works for the local simulator;
# use the key from the Ring Developer Console for real deliveries.
RING_WEBHOOK_SIGNING_KEY=dev-signing-key
# Set to "false" only for local debugging. Signatures are always enforced in production.
RING_VERIFY_SIGNATURES=true

# Office
OFFICE_NAME="Lakeside Therapy"
OFFICE_TIMEZONE=America/Los_Angeles
# Local time, 24h. Rings outside these hours go to the after-hours lane.
OFFICE_OPEN=08:00
OFFICE_CLOSE=18:00
# How early/late an appointment can show up and still be matched (minutes).
MATCH_EARLY_MIN=20
MATCH_LATE_MIN=15

# Chime greeting (optional). When "true", an expected visitor's ring plays an audio
# slot on the office's Ring Chime ("Welcome, someone will be right with you").
# The clip is set up in the Ring app; we only play it. Needs Chime Controls on the app.
# The Playground has no chime, so this is a no-op there.
CHIME_GREETING=false
# Optional: pin the chime device and the slot (configurations → audio.customizable_slots[].event)
CHIME_DEVICE_ID=
CHIME_GREETING_EVENT=

# Calendar (optional). An ICS feed URL or local .ics path: Google Calendar's "secret
# address in iCal format", Outlook's published calendar, Calendly, etc.
# Convention: SUMMARY = visitor name; DESCRIPTION may contain "host: Dr. Lee".
# Unset → data/appointments.json is used.
CALENDAR_ICS_URL=

# Notifications (optional; the dashboard works without them)
SLACK_WEBHOOK_URL=

# AWS Bedrock writes the notice text (optional; template wording is used when unset).
# Needs AWS credentials (env vars or ~/.aws) with Bedrock model access in the region.
AWS_REGION=us-east-1
# Haiku is plenty for a one-sentence notice and costs a fraction of a cent per ring.
# e.g. anthropic.claude-haiku-5-5  (or anthropic.claude-opus-5-5)
BEDROCK_MODEL_ID=

# Where the local JSON store lives
DATA_DIR=./data
